{
  "name": "p2p-ai-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P2P-AI IDE (Tauri): VS Code-style editor shell with Monaco",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "release": "tauri build --no-bundle",
    "tauri": "tauri",
    "ui-smoke": "node tests/ui-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.18",
    "lucide-react": "1.66.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "dompurify": "3.4.18"
  }
}
