{
  "name": "p2p-ai",
  "displayName": "P2P-AI",
  "description": "Chat with the models on a P2P-AI gateway from VS Code or VSCodium, and let them propose changes to your folder for you to review.",
  "version": "0.2.0",
  "publisher": "p2p-ai",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Shatoshinakamoto/P2P-AI-IDE"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "p2pAi",
          "title": "P2P-AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "p2pAi": [
        {
          "type": "webview",
          "id": "p2pAi.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "p2pAi.addGateway",
        "title": "Add Gateway",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.pickGateway",
        "title": "Pick Gateway",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.pickModel",
        "title": "Pick Model",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.setKey",
        "title": "Set Gateway Key",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.removeGateway",
        "title": "Remove Gateway",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.newChat",
        "title": "New Chat",
        "category": "P2P-AI"
      },
      {
        "command": "p2pAi.acceptChange",
        "title": "Accept Change",
        "category": "P2P-AI",
        "icon": "$(check)"
      },
      {
        "command": "p2pAi.rejectChange",
        "title": "Reject Change",
        "category": "P2P-AI",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "p2pAi.acceptChange",
          "when": "resourceScheme == p2p-ai-review",
          "group": "navigation@1"
        },
        {
          "command": "p2pAi.rejectChange",
          "when": "resourceScheme == p2p-ai-review",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "p2pAi.acceptChange",
          "when": "resourceScheme == p2p-ai-review"
        },
        {
          "command": "p2pAi.rejectChange",
          "when": "resourceScheme == p2p-ai-review"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the chat works, but the assistant's tools are off: it can't read the folder or propose changes."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The assistant's tools work on local folders only."
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "npm run build && node tests/integration/run.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out p2p-ai.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.9"
  }
}
